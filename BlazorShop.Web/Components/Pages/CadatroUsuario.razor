@page "/CadastroUsuario"

<div class="registration-container">

    <div class="stepper">
        <div class="step active">
            <div class="step-number">1</div>
            <div class="step-label">Identidade</div>
        </div>
        <div class="step">
            <div class="step-number">2</div>
            <div class="step-label">Acesso</div>
        </div>
        <div class="step">
            <div class="step-number">3</div>
            <div class="step-label">Plano</div>
        </div>
    </div>

    <div class="card custom-card">
        <div class="card-body p-0">

            <div class="step-indicator-text">Passo 1 de 3</div>
            <h1 class="card-title">Cadastro</h1>
            <p class="card-subtitle">Vamos começar com o básico</p>

            <form>
                <div class="mb-4">
                    <label for="nomeCompleto" class="form-label">Nome completo</label>
                    <input type="text" id="nomeCompleto" class="form-control" placeholder="Ana Silva" />
                </div>

                <div class="mb-4">
                    <label for="emailProfissional" class="form-label">E-mail profissional</label>
                    <input type="email" id="emailProfissional" class="form-control" placeholder="ana@empresa.com" />
                </div>

                <button type="submit" class="btn btn-continue">
                    Continuar
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M3.33334 8H12.6667" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                        <path d="M8 3.33334L12.6667 8L8 12.6667" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                </button>
            </form>

        </div>
    </div>

</div>