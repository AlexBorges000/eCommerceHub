@page "/ProdutoDetalhes/{id:int}"

@if (Produto is null)
{
    <ExibirSpinner />
}
else if (MensagemErro is not null)
{
    <ExibirErro MensagemErro="@MensagemErro" />
}
else
{ 
    <MudText Typo="Typo.h3" Class="mb-5">
        Detalhes do Produto
    </MudText>
    <MudPaper Class="pa-6" Elevation="2">
        <MudGrid Spacing="4">
            <MudItem xs="12" md="6">
                <MudImage Src="@Produto.ImagemUrl"
                          Alt="@Produto.Nome"
                          Fluid="true"
                          Class="rounded" />
            </MudItem>
            <MudItem xs="12" md="6">

                <MudText Typo="Typo.h4" GutterBottom="true">
                    @Produto.Nome
                </MudText>

                <MudText Typo="Typo.body1" Class="mb-4">
                    @Produto.Descricao
                </MudText>

                <MudText Typo="Typo.h6" Color="Color.Primary">
                    @Produto.Preco.ToString("C")
                </MudText>

                <MudText Typo="Typo.body2" Class="mb-4">
                    @Produto.Quantidade itens em estoque
                </MudText>
                <MudNumericField T="int"
                                 Label="Quantidade"
                                 @bind-value="ProdQuantidade"
                                 Min="1"
                                 Max="@Produto.Quantidade"
                                 Variant="Variant.Outlined"
                                 Style="max-width:150px;" />
                <MudButton Class="mt-4"
                           Variant="Variant.Filled"
                           Color="Color.Success"
                           StartIcon="@Icons.Material.Filled.ShoppingCart"
                           OnClick="AdicionarAoCarrinho_Click">

                    Incluir no Carrinho
                </MudButton>
            </MudItem>
        </MudGrid>
    </MudPaper>
}

@code {
    [Inject]
    public IProdutoService ProdutoService { get; set; } = null!;
    [Inject]
    public ICarrinhoCompraService CarrinhoCompraService { get; set; } = null!;
    [Inject]
    public NavigationManager NavigationManager { get; set; }= default!;

    [Parameter]
    public int id { get; set; }
    public RequestGetProdutoDto? Produto { get; set; } = null!;
    public string? MensagemErro { get; set; }
    public int ProdQuantidade { get; set; } = 1;
    public RequestCarrinhoItemAdicionaDto carrinhoItemAdicionaDto { get; set; } = null!;
    @inject HttpClient Http

    protected override async Task OnInitializedAsync()
    {
        OperationResult<RequestGetProdutoDto> resultado = await ProdutoService.GetItem(id);
        if (resultado.Success)
        {
            Produto = resultado.Value ?? new RequestGetProdutoDto();
        }
        else
        {
            MensagemErro = resultado.Message;
        }
    }

    protected async Task AdicionarAoCarrinho_Click()
    {
        var dto = new RequestCarrinhoItemAdicionaDto
        {
            CarrinhoId = UsuarioLogado.CarrinhoId,
            ProdutoId = Produto!.Id,
            Quantidade = ProdQuantidade
        };

        var carrinhoItemDto = await CarrinhoCompraService.AdicionaItem(dto);
        NavigationManager.NavigateTo("/CarrinhoCompra");    
    }
}
