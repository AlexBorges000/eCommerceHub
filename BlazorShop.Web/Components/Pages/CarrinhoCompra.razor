@page "/CarrinhoCompra"
@rendermode InteractiveServer
@if (CarrinhoCompraItens?.Count < 1 && MensagemErro is null)
{
    <ExibirSpinner />
}
else if (MensagemErro is not null)
{
    <ExibirErro MensagemErro="@MensagemErro" />
}
else
{

    <h3 class="mb-5">Carrinho</h3>
    @if (CarrinhoCompraItens != null)
    {
        <div class="row mb-5">
            <div class="col-md-9">
                @foreach (var item in CarrinhoCompraItens)
                {      
                    <div class="row mb-3">
                        <div class="col-md-3">
                            <img src="@item.ProdutoImagemURL" width="250" class="img-thumbnail" />
                        </div>
                        <div class="col-md-9">
                            <h5>@item.ProdutoNome</h5>
                            <div class="mb-4">
                                @item.ProdutoDescricao
                            </div>
                            <label>Quantidade:</label>
                            <input type="number" @bind-value="@item.Quantidade" @bind-value:event="oninput" @bind-value:after="() => OnInput(item.Id)" "min=" 1" max="99" />
                            <br />
                            <span>Valor Total:<b>@(item.Preco * item.Quantidade)</b></span>
                            <div>
                                <button class="btn btn-danger sm" @onclick="() => DeleteCarrinhoItem_Click(item.Id)">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-trash" viewBox="0 0 16 16">
                                        <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0z" />
                                        <path d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4zM2.5 3h11V2h-11z" />
                                    </svg>
                                </button>
                            </div>
                        </div>

                    </div>
                }
            </div>
            <div class="col-md-3">
                <h5> Carrinho - Resumo</h5>
                <div class="mt-2">
                    <div>Total - @ValorFinal().ToString("C")</div>
                    <a href="#" class="btn btn-success">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-credit-card" viewBox="0 0 16 16">
                            <path d="M0 4a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2zm2-1a1 1 0 0 0-1 1v1h14V4a1 1 0 0 0-1-1zm13 4H1v5a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1z" />
                            <path d="M2 10a1 1 0 0 1 1-1h1a1 1 0 0 1 1 1v1a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1z" />
                        </svg>&nbsp; Finalizar Pedido
                    </a>
                </div>
            </div>
        </div>
    }
    else
    {
        <div>
            <h3><b>O carrinho está vazio.</b></h3>
        </div>
    }
}

@code {
    [Inject]
    public ICarrinhoCompraService CarrinhoCompraService { get; set; } = null!;
    public List<CarrinhoItemDto> CarrinhoCompraItens { get; set; } = null!;
    public CarrinhoItemAtualizaQuantidadeDto carrinhoItemAtualizaQuantidadeDtos { get; set; } = null!;
    public string? MensagemErro { get; set; }
    private CancellationTokenSource? _cts;

    protected override async Task OnInitializedAsync()
    {
        var result = await CarrinhoCompraService.GetItensReturnsResult(UsuarioLogado.CarrinhoId);
        if (!result.Success)
        {
            MensagemErro = result.Message;
        }
        CarrinhoCompraItens = result.Value;
    }

    protected async Task DeleteCarrinhoItem_Click(int id)
    {
        var carrinhoItemDto = await CarrinhoCompraService.DeleteItem(id);

        await RemoveCarrinhoItem(id);
    }

    private CarrinhoItemDto GetCarrinhoItem(int id)
    {
        var produtos = CarrinhoCompraItens.SingleOrDefault(x => x.Id == id);
        return produtos;
    }

    private decimal ValorFinal()
    {
        return CarrinhoCompraItens
        .Sum(itens => itens.Preco * itens.Quantidade);
    }

    private async Task UpdateQuantidade(int id)
    {
        await Task.Delay(TimeSpan.FromSeconds(2));

        var produto = CarrinhoCompraItens
            .SingleOrDefault(x => x.Id == id);

        var carrinhodto = new CarrinhoItemAtualizaQuantidadeDto
        {
            CarrinhoItemId = id,
            Quantidade = produto.Quantidade
        };
        if (carrinhodto.Quantidade == 0)
        {
            await DeleteCarrinhoItem_Click(produto.Id);
        }
        await CarrinhoCompraService.AtualizaQuantidade(carrinhodto);

    }

    private async Task RemoveCarrinhoItem(int id)
    {
        var carrinhoItemDto = GetCarrinhoItem(id);
        CarrinhoCompraItens.Remove(carrinhoItemDto);
    }

    private async Task OnInput(int id)
    {
        _cts?.Cancel();
        _cts = new CancellationTokenSource();
        try
        {
            await Task.Delay(TimeSpan.FromSeconds(3), _cts.Token);

            await UpdateQuantidade(id);
        }
        catch (TaskCanceledException)
        {
            return;
        }
    }
}
