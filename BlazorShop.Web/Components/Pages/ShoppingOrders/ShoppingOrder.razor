@page "/shopping-order"
@rendermode InteractiveServer
@if (ShoppingOrderItems?.Count < 1 && ErrorMessage is null)
{
    <DisplaySpinner />
}
else if (ErrorMessage is not null)
{
    <ErrorDisplay ErrorMessage="@ErrorMessage" />
}
else
{

    <h3 class="mb-5">Carrinho</h3>
    @if (ShoppingOrderItems != null)
    {
        <MudGrid Class="mb-5">
            <MudItem xs="12" md="9">
                @foreach (var item in ShoppingOrderItems)
                {
                    <DisplayOrder Item="item"
                                    OnDelete="DeleteOrderItem_Click"
                                    OnInput="OnInput"
                                    Id="item.ProductId" />
                }
            </MudItem>

            <MudItem xs="12" md="3">
                <CloseOrder Total="FinalValue()" />
            </MudItem>
        </MudGrid>
    }
    else
    {
        <div>
            <h3><b>O carrinho está vazio.</b></h3>
        </div>
    }
}



@code {
    [Inject]
    public IShoppingOrderService ShoppingOrderService { get; set; } = null!;

    [Parameter]
    public IEnumerable<ProductRequestDto>? Products { get; set; }

    public List<OrderItemDto> ShoppingOrderItems { get; set; } = null!;
    public string? ErrorMessage { get; set; }
    private readonly Dictionary<int, CancellationTokenSource> _tokens = [];

    protected override async Task OnInitializedAsync()
    {
        var result = await ShoppingOrderService.GetItems(LoggedInUser.OrderId);
        if (result is null)
        {
            ErrorMessage = "Carrinho Nulo";
            return;
        }
        if (!result.Success)
        {
            ErrorMessage = result.Message;
            return;
        }
        ShoppingOrderItems = result.Value;
    }

    protected async Task DeleteOrderItem_Click(int id)
    {
        var orderItemDto = await ShoppingOrderService.DeleteItem(id);

        await RemoveOrderItem(id);
    }

    private OrderItemDto GetOrderItem(int id)
    {
        var products = ShoppingOrderItems.SingleOrDefault(x => x.Id == id)
        ?? throw new Exception("Item não encontrado no carrinho");
        return products;
    }

    private decimal FinalValue()
    {
        return ShoppingOrderItems
        .Sum(items => items.Price * items.Quantity);
    }

    private async Task UpdateQuantity(int id)
    {
        var product = ShoppingOrderItems
            .SingleOrDefault(x => x.Id == id);
        if (product is not null)
        {
            var orderdto = new OrderItemQuantityUpdateRequestDto
                {
                    OrderItemId = id,
                    Quantity = product.Quantity
                };

            if (orderdto.Quantity > 0)
            {
                await ShoppingOrderService.UpdateQuantity(orderdto);
            }
            else
            {
                await DeleteOrderItem_Click(product.Id);
            }
        }

    }

    private async Task RemoveOrderItem(int id)
    {
        var orderItemDto = GetOrderItem(id);
        ShoppingOrderItems.Remove(orderItemDto);
    }

    private async Task OnInput(int id)
    {
        if (_tokens.TryGetValue(id, out var cts))
        {
            cts.Cancel();
            cts.Dispose();
        }

        cts = new CancellationTokenSource();

        _tokens[id] = cts;

        try
        {
            await Task.Delay(TimeSpan.FromSeconds(50), cts.Token);
            await UpdateQuantity(id);
        }
        catch (TaskCanceledException)
        {
            return;
        }
    }
    
}
