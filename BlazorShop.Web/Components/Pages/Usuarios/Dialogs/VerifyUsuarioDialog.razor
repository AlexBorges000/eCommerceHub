@inject IDialogService DialogService

<MudDialog>
    <DialogContent>
        <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
            <MudText Typo="Typo.h6">
                Acesse sua conta ou cadastre-se
            </MudText>
            <MudIconButton Icon="@Icons.Material.Filled.Close" OnClick="Cancel" />
        </MudStack>
        <MudStack Row Spacing="1" Class="mt-4">

            <MudTextField T="string"
                          Placeholder="E-mail"
                          @bind-Value="Email"
                          Variant="Variant.Outlined"
                          FullWidth="true" />
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       OnClick="() => FindUsuario(Email)">
                Entrar
            </MudButton>
        </MudStack>
        <MudSpacer />
        <MudText Typo="Typo.caption"
                 Align="Align.Center"
                 Class="mt-4">
            Este site é protegido por reCAPTCHA...
        </MudText>

    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;
    [Inject]
    public IUsuarioService UsuarioService { get; set; } = null!;
    public string Email = string.Empty;
    private readonly DialogOptions _topCenter = new() { Position = DialogPosition.TopRight, BackdropClick = false, MaxWidth = MaxWidth.Large };

    private void Cancel() => MudDialog.Cancel();

    protected async Task<OperationResult<ResponseGetUsuarioDto>> FindUsuario(string email)
    {
        var response = await UsuarioService.GetUsuario(email) ?? OperationResult<ResponseGetUsuarioDto>.Fail("Usuario Não cadastrado");
        if (response.Success)
        {
            await LoginDialog(Email, response.Value);
            return response;
        }
        return OperationResult<ResponseGetUsuarioDto>.Fail("Usuario Não cadastrado");
    }

    private async Task LoginDialog(string email, ResponseGetUsuarioDto responseGetUsuarioDto)
    {
        var parameters = new DialogParameters
        {
            {nameof(LoginUsuarioDialog.Email),  email},
            {nameof(LoginUsuarioDialog.responseGetUsuarioDto), responseGetUsuarioDto}
        };
        await DialogService.ShowAsync<LoginUsuarioDialog>("Login", parameters, _topCenter);
    }
}