<MudDialog>
    <DialogContent>
        <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
            <MudText Typo="Typo.h6">
                Acesse sua conta ou cadastre-se
            </MudText>
            <MudIconButton Icon="@Icons.Material.Filled.Close" OnClick="Cancel" />
        </MudStack>
        <MudStack Row Spacing="1" Class="mt-4">
<!--- TODO: TERMINAR DE FAZER A VERIFICAÇÃO DE LOGIN NO SERVICE, QUANDO O BACKEND ESTIVER PRONTO--->
            <MudTextField T="string"
                          Placeholder="E-mail"
                          @bind-Value="Email"
                          Variant="Variant.Outlined"
                          FullWidth="true" />
                <MudTextField T="string"
                              Placeholder="Senha"
                              @bind-Value="Senha"
                              Variant="Variant.Outlined"
                              FullWidth="true" />
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary">
                Entrar
            </MudButton>
        </MudStack>
        <MudSpacer />
        <MudText Typo="Typo.caption"
                 Align="Align.Center"
                 Class="mt-4">
            Este site é protegido por reCAPTCHA...
        </MudText>

    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter]
    public string Email { get; set; } = string.Empty;
    [Parameter]
    public ResponseGetUsuarioDto responseGetUsuarioDto { get; set; }
    public string Senha { get; set; } = string.Empty;

    private void Cancel() => MudDialog.Cancel();

}
