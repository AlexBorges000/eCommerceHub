@page "/ProdutoDetalhes/{id:int}"
@rendermode InteractiveServer

@if (Produto is null)
{
    <ExibirSpinner />
}
else if (MensagemErro is not null)
{
    <ExibirErro MensagemErro="@MensagemErro" />
}
else
{ 
    <h3 class="mb-5"> Detalhe do Produto</h3>
        <div class="row">

       
            <div class="col-md-6 md-4">
                <img class="img-fluid" src="@Produto.ImagemUrl" alt="@Produto.Nome" />

                <div class="col-md-6">
                    <h3>@Produto.Nome</h3>
                    <p class="mb-4">@Produto.Descricao</p>
                    <p class="mb-4">
                        <b>
                            @Produto.Preco.ToString("C")&nbsp;(@Produto.Quantidade items em estoque)
                        </b>
                        <br/>
                        <label>Quantidade:</label>
                        <input type="number" @bind="Quantidade" min="1" max="@Produto.Quantidade">
                    </p>
                
                
                </div>
                <div>
                    <button class="btn btn-success"
                            @onclick="() => AdicionarAoCarrinho_Click()">

                        Incluir no Carrinho
                    </button>
                </div>
            </div>
        </div>

}

@code {
    [Inject]
    public IProdutoService ProdutoService { get; set; } = null!;
    [Inject]
    public ICarrinhoCompraService CarrinhoCompraService { get; set; } = null!;
    [Inject]
    public NavigationManager NavigationManager { get; set; }= default!;

    [Parameter]
    public int id { get; set; }
    public ProdutoDto? Produto { get; set; } = null!;
    public string? MensagemErro { get; set; }
    public int Quantidade = 1;
    public CarrinhoItemAdicionaDto carrinhoItemAdicionaDto { get; set; } = null!;

    protected override async Task OnInitializedAsync()
    {
        OperationResult<ProdutoDto> resultado = await ProdutoService.GetItem(id);
        if (resultado.Success)
        {
            Produto = resultado.Value ?? new ProdutoDto();
        }
        else
        {
            MensagemErro = resultado.Message;
        }
    }

    protected async Task AdicionarAoCarrinho_Click()
    {
        var dto = new CarrinhoItemAdicionaDto
        {
            CarrinhoId = UsuarioLogado.CarrinhoId,
            ProdutoId = Produto!.Id,
            Quantidade = Quantidade
        };

        var carrinhoItemDto = await CarrinhoCompraService.AdicionaItem(dto);
        NavigationManager.NavigateTo("/CarrinhoCompra");

        
    }
}
